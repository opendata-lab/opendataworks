{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendataworks/contracts/agent-events/v1/neutral-event.schema.json",
  "title": "NeutralAgentEvent",
  "description": "One event from any engine adapter. The type list is closed: an unknown type is a producer bug, not an extension point, because every consumer switches on it and would silently ignore a typo.",
  "type": "object",
  "required": ["event_id", "run_id", "task_id", "sequence", "timestamp", "type", "payload"],
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "task_attempt_id": { "type": "string" },
    "sequence": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "string" },
    "type": {
      "enum": [
        "run.started",
        "turn.started",
        "content.started",
        "content.delta",
        "content.completed",
        "tool.started",
        "tool.completed",
        "tool.denied",
        "usage.updated",
        "turn.completed",
        "run.completed",
        "run.failed",
        "run.cancelled",
        "run.suspended"
      ],
      "description": "tool.progress is deliberately absent: nothing rendered it, so it only grew the record table. Liveness uses the run.heartbeat protocol frame."
    },
    "payload": { "type": "object" }
  }
}
