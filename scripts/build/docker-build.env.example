# Docker 多架构构建配置示例
# 复制此文件为 docker-build.env 并填写实际值

# Docker Hub 凭证
DOCKER_USERNAME=your-dockerhub-username
DOCKER_PASSWORD=your-dockerhub-password-or-token

# 镜像配置
DOCKER_NAMESPACE=opendataworks
VERSION=1.5.0

# 目标平台 (多个平台用逗号分隔)
# 支持: linux/amd64, linux/arm64, linux/arm/v7
PLATFORMS=linux/amd64,linux/arm64

# 构建选项
PUSH_TO_REGISTRY=true
BUILD_FRONTEND=true
BUILD_BACKEND=true
BUILD_DATAAGENT_FRONTEND=true
BUILD_DATAAGENT_BACKEND=true
BUILD_DATAAGENT_RUNNER=true
BUILD_PORTAL_MCP=true

# Python pip 镜像源（仅在构建 Python 服务镜像时使用，加速内网构建）
# URL 中不要包含用户名、密码或 Token；需要认证的镜像源后续应通过 BuildKit secret 接入。
# 优先使用 HTTPS。仅 HTTP 或自签名证书源需要设置 PIP_TRUSTED_HOST。
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# PIP_TRUSTED_HOST=mirrors.aliyun.com
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
