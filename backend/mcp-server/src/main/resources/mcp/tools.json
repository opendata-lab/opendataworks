  {
    "name": "odw_update_table_metadata",
    "description": "Complete the metadata of an existing table: table comment, controlled attributes (layer / business-domain / data-domain), per-field comments, and the data-freshness contract. Locate the table by tableId (preferred) or database + table. Discover weak/missing metadata first with odw_search_tables / odw_export_metadata, then read context with odw_get_table_ddl. Controlled values outside the platform lists are dropped server-side; freshness loadedAtField must be a real column. Each section is applied independently and the result lists applied / skipped / failed.",
    "readOnly": false,
    "destructive": false,
    "inputSchema": {
      "type": "object",
      "properties": {
        "tableId": {
          "type": "integer",
          "description": "表 ID(优先)"
        },
        "database": {
          "type": "string",
          "description": "库名(与 table 一起在缺 table_id 时定位)"
        },
        "table": {
          "type": "string",
          "description": "表名(与 database 一起在缺 table_id 时定位)"
        },
        "tableComment": {
          "type": "string",
          "description": "表业务描述"
        },
        "attributes": {
          "type": "object",
          "properties": {
            "layer": {
              "type": "string",
              "description": "数仓分层:ODS/DWD/DIM/DWS/ADS(清单外一律丢弃)"
            },
            "businessDomain": {
              "type": "string",
              "description": "业务域编码(必须是平台已有编码)"
            },
            "dataDomain": {
              "type": "string",
              "description": "数据域编码(必须存在且归属所选业务域)"
            }
          },
          "required": [],
          "additionalProperties": false,
          "description": "受控属性:分层/业务域/数据域"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fieldName": {
                "type": "string",
                "description": "字段名(与 field_id 二选一)"
              },
              "fieldId": {
                "type": "integer",
                "description": "字段 ID(与 field_name 二选一)"
              },
              "comment": {
                "type": "string",
                "description": "字段业务注释"
              }
            },
            "required": [
              "comment"
            ],
            "additionalProperties": false
          },
          "description": "逐字段注释"
        },
        "freshness": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "column",
                "custom_sql",
                "metadata"
              ],
              "description": "取值方式,默认 column"
            },
            "loadedAtField": {
              "type": "string",
              "description": "column 模式:取最大值的时间列(必须是真实字段)"
            },
            "loadedAtQuery": {
              "type": "string",
              "description": "custom_sql 模式:返回最新时间的 SQL"
            },
            "filterExpr": {
              "type": "string",
              "description": "可选 WHERE 谓词"
            },
            "warnAfterCount": {
              "type": "integer",
              "minimum": 1,
              "description": "预警阈值数量,默认 1"
            },
            "warnAfterPeriod": {
              "type": "string",
              "enum": [
                "minute",
                "hour",
                "day"
              ],
              "description": "预警阈值单位,默认 day"
            },
            "errorAfterCount": {
              "type": "integer",
              "minimum": 1,
              "description": "过期阈值数量,默认 1"
            },
            "errorAfterPeriod": {
              "type": "string",
              "enum": [
                "minute",
                "hour",
                "day"
              ],
              "description": "过期阈值单位,默认 day"
            },
            "enabled": {
              "type": "boolean",
              "description": "是否启用,默认 true"
            }
          },
          "required": [],
          "additionalProperties": false,
          "description": "数据新鲜度契约"
        },
        "description": {
          "type": "string",
          "description": "本次工具调用的简短中文意图，仅用于展示"
        }
      },
      "required": [],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "tableId"
          ]
        },
        {
          "required": [
            "database",
            "table"
          ]
        }
      ]
    }
  },
  {
    "name": "odw_create_task",
    "description": "Create a draft data-development task (e.g. a SQL task). Both input_tableIds and output_tableIds must be provided explicitly; pass [] for no inputs, and at least one output id.",
    "readOnly": false,
    "destructive": false,
    "inputSchema": {
      "type": "object",
      "properties": {
        "task": {
          "type": "object",
          "properties": {
            "taskName": {
              "type": "string"
            },
            "taskCode": {
              "type": "string"
            },
            "taskType": {
              "type": "string"
            },
            "engine": {
              "type": "string"
            },
            "dolphinNodeType": {
              "type": "string"
            },
            "datasourceName": {
              "type": "string"
            },
            "datasourceType": {
              "type": "string"
            },
            "taskGroupName": {
              "type": "string"
            },
            "targetDatasourceName": {
              "type": "string"
            },
            "sourceTable": {
              "type": "string"
            },
            "targetTable": {
              "type": "string"
            },
            "columnMapping": {
              "type": "string"
            },
            "taskSql": {
              "type": "string"
            },
            "taskDesc": {
              "type": "string"
            },
            "scheduleCron": {
              "type": "string"
            },
            "priority": {
              "type": "integer"
            },
            "timeoutSeconds": {
              "type": "integer"
            },
            "retryTimes": {
              "type": "integer"
            },
            "retryInterval": {
              "type": "integer"
            },
            "owner": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "dolphinFlag": {
              "type": "string"
            },
            "workflowId": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "inputTableIds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "输入表 ID 列表(维护血缘);无输入表时显式传 []"
        },
        "outputTableIds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "输出表 ID 列表(维护血缘);至少一个",
          "minItems": 1
        },
        "description": {
          "type": "string",
          "description": "本次工具调用的简短中文意图，仅用于展示"
        }
      },
      "required": [
        "task",
        "inputTableIds",
        "outputTableIds"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "odw_update_task",
    "description": "Update a draft task definition. Lineage lists are full replacements: omit a side to keep its existing lineage, pass a full array to replace it. Never pass a partial list — omitted table ids are deleted.",
    "readOnly": false,
    "destructive": false,
    "inputSchema": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "integer",
          "description": "任务 ID"
        },
        "task": {
          "type": "object",
          "properties": {
            "taskName": {
              "type": "string"
            },
            "taskCode": {
              "type": "string"
            },
            "taskType": {
              "type": "string"
            },
            "engine": {
              "type": "string"
            },
            "dolphinNodeType": {
              "type": "string"
            },
            "datasourceName": {
              "type": "string"
            },
            "datasourceType": {
              "type": "string"
            },
            "taskGroupName": {
              "type": "string"
            },
            "targetDatasourceName": {
              "type": "string"
            },
            "sourceTable": {
              "type": "string"
            },
