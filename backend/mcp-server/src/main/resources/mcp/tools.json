  {
    "name": "odw_query_readonly",
    "description": "Execute a single read-only SQL query through the backend read-only query path.",
    "readOnly": true,
    "destructive": false,
    "inputSchema": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "description": "本次工具调用的简短中文意图说明，仅用于前端展示，例如“搜索订单相关表”；不参与查询逻辑。"
        },
        "database": {
          "type": "string",
          "description": "数据库名"
        },
        "sql": {
          "type": "string",
          "minLength": 1,
          "description": "单条只读 SQL"
        },
        "preferredEngine": {
          "type": "string",
          "enum": [
            "mysql",
            "doris",
            "postgresql"
          ],
          "description": "期望引擎，可选"
        },
        "limit": {
          "type": "integer",
          "default": 1000,
          "minimum": 1,
          "maximum": 10000,
          "description": "结果返回上限"
        },
        "timeoutSeconds": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "maximum": 120,
          "description": "单次查询超时秒数"
        }
      },
      "required": [
        "database",
        "sql"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "odw_preview_create_table",
    "description": "Preview a new target table: returns the generated table name and normalized CREATE TABLE DDL without creating anything. Follow the data-dev skill DDL standards; use before odw_create_table.",
    "readOnly": true,
    "destructive": false,
    "inputSchema": {
      "type": "object",
      "properties": {
        "dbName": {
          "type": "string",
          "description": "目标数据库名"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "columnName": {
                "type": "string",
                "description": "列名"
              },
              "dataType": {
                "type": "string",
                "description": "数据类型,如 BIGINT/VARCHAR/DECIMAL/DATETIME/STRING"
              },
              "typeParams": {
                "type": "string",
                "description": "类型参数,如 '64'(VARCHAR)或 '18,2'(DECIMAL)"
              },
              "nullable": {
                "type": "boolean",
                "description": "是否可空,默认可空"
              },
              "primaryKey": {
                "type": "boolean",
                "description": "是否为 KEY/主键列"
              },
              "partitionColumn": {
                "type": "boolean",
                "description": "是否为分区列"
              },
              "defaultValue": {
                "type": "string",
                "description": "默认值"
              },
              "comment": {
                "type": "string",
                "description": "列注释"
              }
            },
            "required": [
              "columnName",
              "dataType"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "description": "列定义(至少一列),每列建议带 comment"
        },
        "layer": {
          "type": "string",
          "description": "数仓分层:ods/dwd/dws/dim/ads,用于生成表名"
        },
        "businessDomain": {
          "type": "string",
          "description": "业务域,用于生成表名"
        },
        "dataDomain": {
          "type": "string",
          "description": "数据域,用于生成表名"
        },
        "customIdentifier": {
          "type": "string",
          "description": "自定义标识,用于生成表名"
        },
        "statisticsCycle": {
          "type": "string",
          "description": "统计周期,用于生成表名"
        },
        "updateType": {
          "type": "string",
          "description": "刷新方式,如 di(按日增量)/df(按日全量)"
        },
        "tableComment": {
          "type": "string",
          "description": "表注释"
        },
        "owner": {
          "type": "string",
          "description": "负责人,可选(默认取调用者身份)"
        },
        "tableModel": {
          "type": "string",
          "description": "Doris 表模型:DUPLICATE(默认/明细)/AGGREGATE/UNIQUE"
        },
        "bucketNum": {
          "type": "integer",
          "minimum": 1,
          "description": "分桶数,默认 10"
        },
        "replicaNum": {
          "type": "integer",
          "minimum": 1,
          "description": "副本数,默认 3(本地/测试用 1)"
        },
        "partitionColumn": {
          "type": "string",
          "description": "分区列(RANGE 分区)"
        },
        "distributionColumns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "分桶键(DISTRIBUTED BY HASH)"
        },
        "keyColumns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "KEY 列(表模型 KEY(...),顺序敏感)"
        },
        "dorisClusterId": {
          "type": "integer",
          "description": "目标 Doris 集群/数据源 ID;执行建表必填,预览可省"
        },
        "syncToDoris": {
          "type": "boolean",
          "description": "是否在引擎执行建表;默认执行,置 false 仅登记元数据"
        },
        "dorisDdl": {
          "type": "string",
          "description": "高级:直接提供完整 Doris CREATE TABLE DDL"
        },
        "description": {
          "type": "string",
          "description": "本次工具调用的简短中文意图，仅用于展示"
        }
      },
      "required": [
        "dbName",
        "columns"
      ],
      "additionalProperties": false
    }
  },
