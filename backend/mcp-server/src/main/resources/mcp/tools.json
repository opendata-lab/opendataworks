        },
        "table": {
          "type": "string",
          "description": "表名，可选"
        },
        "dbName": {
          "type": "string",
          "description": "数据库名，可选"
        },
        "tableId": {
          "type": "integer",
          "description": "表 ID，可选"
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
