[
  {
    "name": "odw_search_tables",
    "description": "Search OpenDataWorks tables by database, table name, or comment keyword.",
    "readOnly": true,
    "destructive": false,
    "inputSchema": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "description": "本次工具调用的简短中文意图说明，仅用于前端展示，例如“搜索订单相关表”；不参与查询逻辑。"
        },
        "database": {
          "type": "string",
          "description": "数据库名，可选"
        },
        "table": {
          "type": "string",
          "description": "表名，可选"
        },
        "keyword": {
          "type": "string",
          "description": "表注释、字段注释或字段名关键字，可选"
        },
        "tableLimit": {
          "type": "integer",
          "default": 12,
          "minimum": 1,
          "maximum": 100,
          "description": "返回表数量上限"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
