# OpenDataWorks 部署输入：复制为 deploy/.env，只修改与目标环境不同的值。
# 应用策略使用代码默认；DataAgent 运行预算见 docker/dataagent/dataagent_config_docker.py.example。

# 数据库与认证。Spring 连接默认由 MYSQL_* 推导，无需再填一组 SPRING_DATASOURCE_*。
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=opendataworks
MYSQL_USER=opendataworks
MYSQL_PASSWORD=opendataworks123
DATAAGENT_MYSQL_USER=dataagent
DATAAGENT_MYSQL_PASSWORD=dataagent123
AUTH_JWT_SECRET=opendataworks-dev-jwt-secret-change-me
AGENT_API_SERVICE_TOKEN=odw-agent-service-token
ODW_MCP_SERVER_TOKEN=odw-odw-mcp-server-token
TZ=Asia/Shanghai

# 宿主机持久化目录。相对路径按 deploy/ 解析；直接 compose 启动时 HOST_ROOT 用绝对路径。
DATAAGENT_HOST_ROOT=/dataagent_runtime

# 以下仅在偏离默认部署时启用。
# HTTPS 入口：AUTH_COOKIE_SECURE=true；DataAgent 登录见 docker/dataagent/ 下的外置配置示例。
# AUTH_COOKIE_SECURE=true
# DATAAGENT_RUNTIME_UID=1000
# DATAAGENT_RUNTIME_GID=1000
# DATAAGENT_DOCKER_SOCKET=/var/run/docker.sock
# 标准 runner 镜像使用 Docker CLI；Podman 宿主改为挂载其兼容 socket，不切换镜像内 CLI。
# 源码部署默认直接执行；离线包会自动开启 container。
# DATAAGENT_SANDBOX_MODE=container
# 默认 Pi；确需切换旧引擎时启用：
# DATAAGENT_RUNTIME_KIND=claude_code
# 生产网络与宿主/VPN 冲突时修改；dev 使用 Compose 默认网络。
# OPENDATAWORKS_PROD_SUBNET=10.71.0.0/24
# OPENDATAWORKS_PROD_GATEWAY=10.71.0.1

# 可选镜像覆盖；离线打包脚本自动填入实际 tag。
# OPENDATAWORKS_BACKEND_IMAGE=opendataworks-backend:1.5.0
# OPENDATAWORKS_FRONTEND_IMAGE=opendataworks-frontend:1.5.0
# OPENDATAWORKS_DATAAGENT_FRONTEND_IMAGE=oda-frontend:1.5.0
# OPENDATAWORKS_DATAAGENT_BACKEND_IMAGE=oda-backend:1.5.0
# OPENDATAWORKS_DATAAGENT_RUNNER_IMAGE=oda-runner:1.5.0
# OPENDATAWORKS_ODW_MCP_SERVER_IMAGE=opendataworks-odw-mcp-server:1.5.0

# 高级覆盖、已有配置迁移和服务默认值见 deploy/README.md。
# 保留实际环境的自定义值；升级/离线加载不会覆盖已有 deploy/.env。
