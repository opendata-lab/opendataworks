# OpenDataWorks 部署输入：复制为 deploy/.env，只修改与目标环境不同的值。
# DataAgent 由 opendataagent 仓库单独部署，其配置不在此文件中。

# 数据库与认证。Spring 连接默认由 MYSQL_* 推导，无需再填一组 SPRING_DATASOURCE_*。
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=opendataworks
MYSQL_USER=opendataworks
MYSQL_PASSWORD=opendataworks123
AUTH_JWT_SECRET=opendataworks-dev-jwt-secret-change-me
AGENT_API_SERVICE_TOKEN=odw-agent-service-token
ODW_MCP_SERVER_TOKEN=odw-odw-mcp-server-token
TZ=Asia/Shanghai

# 以下仅在偏离默认部署时启用。
# HTTPS 入口：
# AUTH_COOKIE_SECURE=true
# 日志收集 sidecar 读取的容器运行时 socket；Podman 宿主改为其兼容 socket。
# DOCKER_SOCKET=/var/run/docker.sock
# 生产网络与宿主/VPN 冲突时修改；dev 使用 Compose 默认网络。
# OPENDATAWORKS_PROD_SUBNET=10.71.0.0/24
# OPENDATAWORKS_PROD_GATEWAY=10.71.0.1

# 可选镜像覆盖；离线打包脚本自动填入实际 tag。
# OPENDATAWORKS_BACKEND_IMAGE=opendataworks-backend:1.5.0
# OPENDATAWORKS_FRONTEND_IMAGE=opendataworks-frontend:1.5.0
# OPENDATAWORKS_ODW_MCP_SERVER_IMAGE=opendataworks-odw-mcp-server:1.5.0
# LOG_COLLECTOR_IMAGE=docker:27.5.1-cli

# 高级覆盖、已有配置迁移和服务默认值见 deploy/README.md。
# 保留实际环境的自定义值；升级/离线加载不会覆盖已有 deploy/.env。
