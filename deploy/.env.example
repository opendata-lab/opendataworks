# OpenDataWorks 容器环境配置
# 复制此文件为 deploy/.env 并根据实际环境修改

# 镜像版本（发布时与版本号一致，默认使用 Docker Hub 在线拉取）
# 离线部署包需在 deploy/.env 中设置（create-offline-package.sh 会自动处理）：
# OPENDATAWORKS_BACKEND_IMAGE=opendataworks-backend:1.5.0
# OPENDATAWORKS_FRONTEND_IMAGE=opendataworks-frontend:1.5.0
# OPENDATAWORKS_DATAAGENT_FRONTEND_IMAGE=opendataworks-dataagent-frontend:1.5.0
# OPENDATAWORKS_DATAAGENT_BACKEND_IMAGE=opendataworks-dataagent-backend:1.5.0
# OPENDATAWORKS_DATAAGENT_RUNNER_IMAGE=opendataworks-dataagent-runner:1.5.0
# OPENDATAWORKS_DATAAGENT_EVALS_BUILTIN_IMAGE=opendataworks-dataagent-evals-builtin:1.5.0
# OPENDATAWORKS_DATAAGENT_EVALS_DEEPEVAL_IMAGE=opendataworks-dataagent-evals-deepeval:1.5.0
# OPENDATAWORKS_PORTAL_MCP_IMAGE=opendataworks-portal-mcp:1.5.0

# 自定义 Docker 网络网段（建议按环境拆分，避免与宿主机/VPN 网段冲突）
OPENDATAWORKS_PROD_SUBNET=10.71.0.0/24
OPENDATAWORKS_PROD_GATEWAY=10.71.0.1
OPENDATAWORKS_DEV_SUBNET=10.72.0.0/24
OPENDATAWORKS_DEV_GATEWAY=10.72.0.1

# MySQL 配置（Compose 会读取这些变量）
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=opendataworks
MYSQL_USER=opendataworks
MYSQL_PASSWORD=opendataworks123

# 后端数据源（容器通过 env_file 注入）
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/opendataworks?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=opendataworks
SPRING_DATASOURCE_PASSWORD=opendataworks123
# Doris 审计访问统计增量同步。关闭后保留已有汇总与数据清理，但不再读取 Doris 审计表。
# 汇总只做增量累积，不回填历史；热点表约 30 天、长期未用表约 90 天后开始生效。
DORIS_AUDIT_ACCESS_SYNC_ENABLED=true
# 默认每 10 分钟同步一次；安全延迟默认 2 分钟。
DORIS_AUDIT_ACCESS_SYNC_FIXED_DELAY_MS=600000
DORIS_AUDIT_ACCESS_SYNC_SAFETY_LAG_MINUTES=2
DORIS_AUDIT_ACCESS_SYNC_OVERLAP_MINUTES=10
DORIS_AUDIT_ACCESS_SYNC_BATCH_SIZE=5000
DORIS_AUDIT_ACCESS_SYNC_SUMMARY_RETENTION_DAYS=400
DORIS_AUDIT_ACCESS_SYNC_EVENT_RETENTION_DAYS=7
AGENT_API_SERVICE_TOKEN=odw-agent-service-token
AGENT_API_REQUIRE_PRIVATE_NETWORK=true
PORTAL_MCP_TOKEN=odw-portal-mcp-token
PORTAL_MCP_TOKEN_HEADER_NAME=X-Portal-MCP-Token
PORTAL_MCP_BACKEND_BASE_URL=http://backend:8080/api
PORTAL_MCP_BACKEND_TIMEOUT_SECONDS=30
PORTAL_MCP_MOUNT_PATH=/mcp
# portal-mcp HTTP 空闲 keep-alive 超时（秒）。uvicorn 默认仅 5s，会在模型思考间隙
# 关闭 MCP 客户端的空闲连接，导致对话到后面执行工具报 `session expired`。
# 默认 600，需大于交互 agent run 总超时（360s）。后台重场景可上调。
# 注意：keepalive 只覆盖 uvicorn 的「空闲连接被关闭」一类，不处理 server 重启/OOM 或
# MCP SDK 的 session eviction；那几类 keepalive 无效，需靠 portal-mcp 无状态（已固定
# stateless_http=True 并钉死 mcp/uvicorn 版本，见 dataagent/portal-mcp/requirements.txt）
# 来消除「服务端 session 过期」路径。
# 升级 portal-mcp 时注意：latest 是浮动 tag，`docker compose up` 不会自动重拉旧缓存镜像，
# 需显式 `docker compose pull portal-mcp && docker compose up -d portal-mcp`。
# 若仍偶发 session expired，先查 portal-mcp 是否在 churn：
#   docker inspect opendataworks-portal-mcp --format 'RestartCount={{.RestartCount}} OOMKilled={{.State.OOMKilled}}'
# RestartCount>0 / OOMKilled=true 表示 OOM 在反复重启容器、撕断连接，应调大其资源限制。
PORTAL_MCP_KEEPALIVE_TIMEOUT_SECONDS=600

# 平台登录认证（odw-auth）
# 会话 JWT 共享密钥，生产环境必须改为随机值（长度不少于32字符）
AUTH_JWT_SECRET=opendataworks-dev-jwt-secret-change-me
AUTH_JWT_ISSUER=opendataworks
AUTH_JWT_TTL=8h
# 仅 HTTPS 入口时开启会话 Cookie 的 Secure 属性
AUTH_COOKIE_SECURE=false
# 临时回滚开关：true 时无会话请求回退为匿名 admin（恢复登录上线前的旧行为）
AUTH_ANONYMOUS_ENABLED=false
# 初始管理员账号 admin / admin123（V44 迁移写入），首次登录后请立即修改密码

# 时区设置
TZ=Asia/Shanghai

# 主前端构建期 DataAgent Widget 远程 JS 地址。
# 主前端 Nginx 仅反代 /dataagent/widget/ 获取该 widget bundle；
# DataAgent 完整前端（智能问数、管理页）请直接访问 dataagent-frontend（:8901）。
VITE_DATAAGENT_WIDGET_JS_URL=/dataagent/widget/opendataworks-widget.bundle.js

# DataAgent（NL2SQL）配置
# 默认使用独立 dataagent 用户：对 opendataworks 只读，对 dataagent 会话库读写
# 若升级自旧版本且沿用已有 mysql-data volume，请先手动补建该用户后再切换
DATAAGENT_MYSQL_USER=dataagent
DATAAGENT_MYSQL_PASSWORD=dataagent123
DATAAGENT_MYSQL_DATABASE=opendataworks
DATAAGENT_SESSION_MYSQL_DATABASE=dataagent
DATAAGENT_REDIS_PASSWORD=
DATAAGENT_REDIS_DB=0
DATAAGENT_TASK_MAX_CONCURRENCY=8
DATAAGENT_TASK_LEASE_TTL_SECONDS=30
DATAAGENT_TASK_HEARTBEAT_SECONDS=5
DATAAGENT_TASK_RECOVERY_SCAN_INTERVAL_SECONDS=2
DATAAGENT_TASK_RECOVERY_BATCH_SIZE=20
# Max seconds a run waits at an in-chat permission confirmation before auto-denying.
DATAAGENT_TASK_PERMISSION_WAIT_SECONDS=600
DATAAGENT_SCHEDULE_SCAN_INTERVAL_SECONDS=10
DATAAGENT_SCHEDULE_SCAN_BATCH_SIZE=10
DATAAGENT_SCHEDULE_LOCK_TTL_SECONDS=60
ODW_BACKEND_BASE_URL=http://backend:8080/api/v1/ai
ODW_BACKEND_TIMEOUT_SECONDS=30
DATAAGENT_PORTAL_MCP_ENABLED=true
DATAAGENT_PORTAL_MCP_BASE_URL=http://portal-mcp:8801/mcp/
# Streamable HTTP MCP 工具调用总上限（秒）。runtime 会转换为进程级
# MCP_TOOL_TIMEOUT 毫秒值；180s 覆盖 portal 查询最长 120s 契约。同一 CLI 中新增
# 其它 MCP server 时也会继承该值；调到 300s 以上需同步配置 MCP idle timeout。
DATAAGENT_PORTAL_MCP_TOOL_TIMEOUT_SECONDS=180
# AskUserQuestion 选择卡片开关（默认 true）。置 false 后 AskUserQuestion 不加入 allowed_tools，
# 且无写工具门控的会话回到纯字符串 prompt 形态（更接近 v1.3.0 调用形态）。
DATAAGENT_ASK_USER_QUESTION_ENABLED=true
# 智能问数 Widget 允许嵌入站点白名单已迁移到「智能问数 → Widget 接入」设置页管理，
# 持久化在 da_agent_settings，不再使用环境变量配置。
# DataAgent 外置配置目录 deploy/docker/dataagent/ 已由 compose 默认挂载
# （Superset docker/pythonpath_dev 同款模式）。启用认证：拷贝该目录下的
# dataagent_config_docker.py.example 为 dataagent_config_docker.py
# 并按注释填写后重启 dataagent-backend，无需改 compose 或本文件。
# 语义为 fail-closed：彻底回滚 = 注释掉 compose 中 dataagent-backend 的
# DATAAGENT_CONFIG env（注意关闭后登录用户名下的会话会重新出现在共享
# 匿名池）；env 已设置但配置非法 = 启动失败，不会静默降级为无认证。
# 生产容器默认以非 root 身份运行；compose 中的一次性 init 服务 dataagent-home-init 会以 root
# 预创建 DATAAGENT_HOST_ROOT 并把属主改成下面的 UID/GID，避免非 root backend 写
# /dataagent_runtime 时报 permission denied。如需匹配特定宿主机目录拥有者，改这两个值即可
DATAAGENT_RUNTIME_UID=1000
DATAAGENT_RUNTIME_GID=1000
DATAAGENT_RUNNER_UID=0
DATAAGENT_RUNNER_GID=0
# DataAgent 持久化运行时根目录（宿主机侧），compose 挂载到容器内固定根 /dataagent_runtime。
# 可自定义为任意宿主机目录：
#   - 绝对路径（如 /data/odw/dataagent_runtime）直接生效；
#   - 相对路径（如 ./dataagent-runtime/runtime）按 deploy/ 解析，scripts/start.sh 会在启动
#     compose 前统一展开成宿主机绝对路径，保证 backend 卷挂载与 sandbox runner 反查的
#     child bind 源指向同一目录。若不经 start.sh 直接运行 compose，请填写绝对路径。
DATAAGENT_HOST_ROOT=/dataagent_runtime
# Sandbox 模式：留空表示 backend 进程内直接执行（源码/开发部署默认）；置为 container
# 时 backend 把每个 task 流式委托给 sandbox runner，由 runner 启动独立 child 容器执行。
# 离线包默认改写为 container（见 scripts/create-offline-package.sh）。
DATAAGENT_SANDBOX_MODE=
DATAAGENT_SANDBOX_BACKEND=docker
DATAAGENT_DOCKER_SOCKET=/var/run/docker.sock
# runner 启动时会通过共享的 Docker socket 反查自身 /app/.claude/skills
# 挂载的宿主机源路径，并按当前助手启用范围把具体 skill 只读挂进每个
# task child 容器的 /mnt/workspace/.claude/skills/<folder>。

# 热 child 容器复用：开启后，同一会话(topic)的连续追问在空闲窗口内复用同一个 child 容器，
# 避免每轮都重新创建容器、重启 Python/SDK 的冷启动开销。置为 false 可回退到「每个任务一个一次性容器」。
DATAAGENT_SANDBOX_REUSE_ENABLED=true
# 热 child 容器空闲多久(秒)后由回收器 kill+清理
DATAAGENT_SANDBOX_IDLE_TTL_SECONDS=600
# 热 child 容器的软上限；超过时优先淘汰空闲且最久未用的容器
DATAAGENT_SANDBOX_MAX_WARM_CONTAINERS=32
# 回收器扫描间隔(秒)
DATAAGENT_SANDBOX_REAPER_INTERVAL_SECONDS=30

# 挂载路径（相对于 deploy/）
# Skills 根目录：源码部署默认指向仓库内 dataagent/.claude/skills；离线包会自动改写到 deploy/dataagent-runtime/skills
DATAAGENT_SKILLS_DIR=../dataagent/.claude/skills

# ---- DataAgent 执行引擎（数据面）----
# 选择由哪个引擎执行一轮问答。与 DATAAGENT_SANDBOX_MODE 正交：后者决定隔离拓扑
# （进程内 / 子容器），本项决定在选定拓扑内部用哪个引擎。部署级配置，不支持请求级切换。
#   claude_code   -> claude-agent-sdk（默认，现有行为）
#   pi_agent_core -> Node Pi Cell（dataagent-runtime-pi，stdio 子进程，无端口）
DATAAGENT_RUNTIME_KIND=claude_code
# 仅 pi_agent_core 需要，且仅在偏离镜像内置布局时才需要设置。
# 赋空值会覆盖镜像里的 ENV 默认（/usr/local/bin/node 与 /opt/dataagent-runtime-pi），
# 所以默认保持注释状态，不要写成空赋值。
# ---- DataAgent 上下文治理（仅 pi_agent_core）----
# 裁剪只在上下文越过 high 水位时发生。pi-ai 会缓存 prompt 前缀，每轮重写历史
# 会让缓存每轮失效，代价通常高于裁剪省下的 token。
# 约束：0 < target < high <= 1，非法取值启动即失败。
# DATAAGENT_CONTEXT_PRUNE_HIGH_WATERMARK_RATIO=0.90
# DATAAGENT_CONTEXT_PRUNE_TARGET_RATIO=0.70
# prompt 缓存保留策略：short | long | off。
# 注意 DISABLE_PROMPT_CACHING 是 Claude Code 的变量，pi 运行时从不读取；
# 需要关闭 pi 侧缓存请用下面这一项。
# DATAAGENT_PI_CACHE_RETENTION=short

# DATAAGENT_NODE_BIN=/usr/local/bin/node
# DATAAGENT_RUNTIME_PI_DIR=/opt/dataagent-runtime-pi
