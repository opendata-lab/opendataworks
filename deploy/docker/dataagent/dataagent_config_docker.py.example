"""DataAgent 外置配置用户覆盖示例（Superset superset_config_docker.py 同款机制）。

拷贝本文件为同目录下的 `dataagent_config_docker.py`（已被 .gitignore 忽略，
不会入库），按需修改后重启 dataagent-backend 即生效。本目录在容器内位于
`sys.path` 上，你也可以像 Superset 的 custom_sso_security_manager.py 一样在
同目录放自定义模块并在这里 import（示例见 custom_sso_user_info.py.example）。
"""

# ---------------------------------------------------------------------------
# 认证总开关。置 True 前先完成 SECRET_KEY 与至少一种登录方式（LOCAL_ADMINS / OAUTH_PROVIDERS）。
# ---------------------------------------------------------------------------
AUTH_ENABLED = False

# ---------------------------------------------------------------------------
# 会话 JWT 密钥（HS256）。必须替换为随机值，长度不少于 32 字节：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# 保留占位值或过短会导致启动失败（fail-closed）。
# ---------------------------------------------------------------------------
SECRET_KEY = "CHANGE-ME-generate-with-secrets.token_urlsafe(32)"

# 会话有效期（秒），默认 8 小时。
SESSION_TTL_SECONDS = 28800

# 会话 Cookie。HttpOnly 由代码硬编码，不可配置。HTTPS 入口置 COOKIE_SECURE = True。
COOKIE_NAME = "da_session"
COOKIE_SECURE = False
COOKIE_SAMESITE = "lax"

# ---------------------------------------------------------------------------
# 本地管理员账号（OAuth 不可用时仍可登录）。
# 默认账号：admin / admin123；password_bcrypt 是 admin123 的 bcrypt 哈希。
# 如需改密码，可替换下面的哈希，生成方式：
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
# ---------------------------------------------------------------------------
LOCAL_ADMINS = [
    {"username": "admin", "password_bcrypt": "$2a$10$UH1EXFfUxjTSk75341ddU./2/w63hc0GkmC31RlKgUmiU3eh3iK0i"},
]

# ---------------------------------------------------------------------------
# OAuth2 授权码模式（通用 OIDC Provider）。外形与 Superset/FAB 的
# OAUTH_PROVIDERS 一致；本期仅支持单 Provider，配置多项会启动失败。
# remote_app 内三项核心（client_id / authorize_url / access_token_url）
# 齐全才视为已配置；保持下方空列表则登录页只提供本地密码登录。
# 要启用 OAuth，将下方 provider 模板取消注释并填入真实值。
# ---------------------------------------------------------------------------
OAUTH_PROVIDERS = [
    # {
    #     # Provider 键和登录按钮显示名，也作为用户稳定标识前缀；应使用
    #     # 1-64 位安全 key（如 SSO / github），不能使用保留值 local。
    #     "name": "SSO",
    #     # Font Awesome 4 class，如 fa-github / fa-google；留空则不显示图标。
    #     "icon": "fa-github",
    #     # token_key 为 FAB/Superset 兼容字段；DataAgent 直接解析 access_token。
    #     "token_key": "access_token",
    #     "remote_app": {
    #         "client_id": "your-client-id",
    #         "client_secret": "your-client-secret",
    #         "authorize_url": "https://sso.example.com/oauth/authorize",
    #         "access_token_url": "https://sso.example.com/oauth/token",
    #         # oauth_remotes[provider].get("userinfo") 的相对 URL 基址。
    #         "api_base_url": "https://sso.example.com/oauth/",
    #         "client_kwargs": {"scope": "openid profile"},
    #         # 必须与 IdP 侧注册的回调一致，路径遵循 FAB/Superset 约定，
    #         # 末段与上面的 name 完全一致：
    #         #   https://<dataagent-host>/oauth-authorized/SSO
    #         "redirect_uri": "https://<dataagent-host>/oauth-authorized/SSO",
    #         # DataAgent 当前只实现授权码模式；其他值会 fail-closed 启动失败。
    #         "response_type": "code",
    #         "grant_type": "authorization_code",
    #     },
    # }
]

# ---------------------------------------------------------------------------
# UserInfo 获取与归一化钩子（OAuth 启用时必填），语义对应 Superset/FAB
# custom SecurityManager.oauth_user_info(provider, token_response)。端点和 Provider
# 特定解析逻辑放在自定义模块，不进入通用 OAUTH_PROVIDERS。示例：
#
#   from custom_sso_user_info import oauth_user_info
#   OAUTH_USER_INFO = oauth_user_info
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# OAuth 用户提名为管理员：条目为 "<provider_name>:<sub>"（稳定标识）。
# display_name 可变、不保证唯一，不参与提权。
# 若 OAUTH_USER_INFO 返回了 role 字段，则以钩子返回为准。
# ---------------------------------------------------------------------------
ADMIN_USERS = [
    # "SSO:1024",
]

# ---------------------------------------------------------------------------
# 其他运行时配置覆盖（可选）：键为 dataagent-backend/config.py 中 Settings 的
# 字段名，启动时统一应用；含未知字段会启动失败（fail-closed）。
# ---------------------------------------------------------------------------
DATAAGENT_SETTINGS = {
    # 默认优先：只填写需要偏离默认的值。助手 max_turns=0 继承以下模式默认。
    # 交互 / auto 与后台：轮数 24/40，工具次数 100/200，总秒数 360/1800，
    # Bash 秒数 300/900；SQL 读取秒数 300/900、写入 60，Pi 无活动秒数 300。
    # "agent_interactive_max_turns": 24,
    # "agent_background_max_turns": 40,
    # "agent_interactive_max_tool_calls": 100,  # Pi
    # "agent_background_max_tool_calls": 200,  # Pi
    # "agent_interactive_timeout_seconds": 360,
    # "agent_background_timeout_seconds": 1800,
    # "agent_interactive_bash_timeout_seconds": 300,  # Pi
    # "agent_background_bash_timeout_seconds": 900,  # Pi
    # "dataagent_run_idle_timeout_seconds": 300,  # Pi
    # SQL 超时 <= Bash 超时 < 总超时；增加总超时须同时审查 Nginx 模板。
}
